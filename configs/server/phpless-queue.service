[Unit]
Description=PHPless Queue Worker
After=network.target

[Service]
User=www-data
Group=www-data
Restart=always
RestartSec=3
WorkingDirectory=/var/www/phpless/panel
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
StandardOutput=append:/var/log/phpless-queue.log
StandardError=append:/var/log/phpless-queue.log

[Install]
WantedBy=multi-user.target
