# PHPless Simple Caddyfile
# Use this for initial testing (Step 1.3) before the VM Manager is ready.
# Copy to /etc/caddy/Caddyfile

{
	email admin@phpless.io
}

test.phpless.app {
	reverse_proxy 10.0.1.2:8080

	header {
		X-Powered-By "PHPless"
	}
}

:8081 {
	respond /health "PHPless Host OK" 200
}
